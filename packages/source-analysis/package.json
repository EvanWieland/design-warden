  "dependencies": {
    "@babel/parser": "8.0.7",
    "@babel/types": "8.0.6",
    "@design-warden/core": "workspace:*",
    "@vue/compiler-dom": "3.5.43",
    "postcss": "8.5.29",
    "postcss-scss": "4.0.9",
    "postcss-value-parser": "4.2.0",
    "svelte": "5.57.2",
    "zod": "4.6.5"
