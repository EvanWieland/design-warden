{
  "name": "design-warden",
  "version": "0.2.0",
  "description": "CI check for design-system drift in frontend pull requests, built for UI written by AI coding agents. Deterministic checks for React, Vue, Svelte and CSS, optional visual diffs, and an AI reviewer that can flag but never block.",
  "keywords": ["design-system", "design-tokens", "linter", "code-review", "ci", "frontend", "react", "vue", "svelte", "css", "tailwind", "visual-regression", "accessibility", "ai-agents"],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "files": [
    "dist",
    "starter"
  ],
  "bin": {
    "design-warden": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "design-warden": "./dist/bin.js"
    }
  },
  "dependencies": {
    "@design-warden/core": "workspace:*",
    "@design-warden/semantic-review": "workspace:*",
    "@design-warden/source-analysis": "workspace:*",
    "@design-warden/visual-analysis": "workspace:*"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  }
}
