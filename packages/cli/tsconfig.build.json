// Emits dist/ for npm packages (`pnpm build`); in the repository everything runs from src/ (ADR 0002).
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "tsconfig.build.tsbuildinfo"
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../core/tsconfig.build.json"
    },
    {
      "path": "../semantic-review/tsconfig.build.json"
    },
    {
      "path": "../source-analysis/tsconfig.build.json"
    },
    {
      "path": "../visual-analysis/tsconfig.build.json"
    }
  ]
}
