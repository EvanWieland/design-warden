{
  // Type-checks all Node-side code. Packages run from source on Node >= 24
  // (native type stripping), so this config never emits; see ADR 0002.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["packages/*/src", "packages/*/test", "tools/*/src", "tools/*/test", "tests", "apps/inspector/server", "*.config.ts"]
}
