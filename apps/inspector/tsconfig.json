{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["dom", "es2024"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    // Report types come from @design-warden/core, whose entry is TypeScript source that imports
    // node: modules. Only types cross into the UI (Vite erases them), but tsc checks those files too.
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
